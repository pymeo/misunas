# Ninguna variable de este fichero es obligatoria para "npm run build".
# El tag de afiliado (tusunas-21) y el marketplace (es) son intencionalmente
# NO configurables por entorno: viven fijos en src/config/site.ts porque no
# esperamos operar varios tags/mercados. No los declares aquí: una variable
# de entorno con ese nombre no tendría ningún efecto.

# --- OPCIONALES ---

# Activa el beacon oficial de Cloudflare Web Analytics cuando se define.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Añade <meta name="google-site-verification"> cuando se define. Se obtiene
# al verificar la propiedad de dominio en Google Search Console; sin este
# valor no se renderiza la etiqueta (no se inventa ningún token).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- AMAZON CREATORS API ---
# Integración de media oficial de producto. Ver docs/AMAZON_CREATORS_API.md.
#
# Este fichero contiene NOMBRES y documentación, nunca valores. Los valores
# reales viven solo en:
#   - local: .dev.vars (ignorado por Git)
#   - CI:    Secrets del repositorio (nunca variables ni ficheros)
# Las credenciales NO se declaran como Secrets del Worker de Cloudflare: la
# integración es de tiempo de build (`npm run amazon:sync`), así que el
# runtime nunca las necesita y añadirlas allí solo ampliaría la superficie.

# "true" activa el provider. Con "false" (o sin definir) no se consulta
# Amazon ni se lee el snapshot: todo el catálogo usa el fallback editorial.
AMAZON_CREATORS_API_ENABLED=false

# Credential ID y Credential Secret que genera Associates Central en
# Herramientas → Creators API. NO son claves de AWS ni de PA-API 5.0.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=

# Región de la credencial, tal como la asigna Amazon: v3.1 (Norteamérica),
# v3.2 (Europa) o v3.3 (Lejano Oriente). Determina el endpoint de Login with
# Amazon, y NO se deduce del marketplace: Tus-Uñas consulta www.amazon.es con
# una credencial europea, así que pide el token a api.amazon.co.uk.
# Por defecto v3.2 si no se define.
AMAZON_CREATORS_VERSION=v3.2

# --- Solo para tooling/despliegue remoto de D1 (no las necesita el build) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
