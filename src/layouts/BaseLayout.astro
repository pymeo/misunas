---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import SEOHead from '@/components/SEOHead.astro';
import WebAnalytics from '@/components/WebAnalytics.astro';
import type { TranslationPath } from '@/application/hreflang';
import { breadcrumbJsonLd } from '@/application/jsonld';
import '@/styles/global.css';

interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown>[];
  translations?: TranslationPath[];
  contentType?: 'money' | 'informational' | 'brand' | 'product' | 'tool';
}

const {
  title,
  description,
  canonicalPath,
  image = '/social-card.svg',
  type = 'website',
  noindex = false,
  breadcrumbs = [],
  jsonLd = [],
  translations = [{ locale: 'es', path: canonicalPath }],
  contentType = 'informational',
} = Astro.props;
const breadcrumbData =
  breadcrumbs.length > 1
    ? breadcrumbJsonLd(
        breadcrumbs.map((item) => ({
          name: item.label,
          path: item.href ?? canonicalPath,
        })),
      )
    : null;
const schemas = breadcrumbData ? [...jsonLd, breadcrumbData] : jsonLd;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      {title}
      {description}
      {canonicalPath}
      {image}
      {type}
      {noindex}
      jsonLd={schemas}
      {translations}
    />
  </head>
  <body data-content-type={contentType}>
    <a
      class="sr-only z-50 bg-white p-3 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      href="#contenido">Saltar al contenido</a
    >
    <Header />
    <main id="contenido">
      {
        breadcrumbs.length > 0 && (
          <div class="container-page pt-8">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
    <WebAnalytics />
  </body>
</html>
