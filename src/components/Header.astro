---
import { SITE_NAME } from '@/config/site';
const links = [
  ['/es/unas-semicuradas/', 'Semicuradas'],
  ['/es/tornos-unas/', 'Tornos'],
  ['/es/aspiradores-polvo-unas/', 'Aspiradores'],
  ['/es/comparativas/', 'Comparativas'],
  ['/es/guias/', 'Guías'],
  ['/es/herramientas/', 'Herramientas'],
  ['/es/opiniones/', 'Opiniones'],
];
---

<header class="site-header">
  <div
    class="container-page flex min-h-18 items-center justify-between gap-5 py-3"
  >
    <a class="brand-mark" href="/es/" aria-label={`${SITE_NAME}, inicio`}
      ><span aria-hidden="true">T</span>{SITE_NAME}</a
    >
    <nav
      aria-label="Navegación principal"
      class="hidden min-w-0 items-center gap-5 lg:flex xl:gap-7"
    >
      <ul
        class="flex min-w-0 flex-wrap items-center gap-x-5 gap-y-1 text-sm font-semibold xl:gap-x-6"
      >
        {
          links.map(([href, label]) => (
            <li>
              <a class="nav-link" href={href}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="button-primary text-sm" href="/es/encuentra-tus-unas/"
        >Encuentra tus uñas</a
      >
    </nav>
    <details class="mobile-menu lg:hidden">
      <summary aria-label="Abrir navegación"
        ><span></span><span></span><span></span><span class="sr-only">Menú</span
        ></summary
      >
      <nav
        aria-label="Navegación móvil"
        class="absolute right-4 left-4 top-[4.6rem] z-40 rounded-2xl border border-border bg-surface p-4 shadow-card"
      >
        <ul class="grid gap-1">
          {
            links.map(([href, label]) => (
              <li>
                <a
                  class="block rounded-xl px-4 py-3 font-semibold no-underline"
                  href={href}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="button-primary mt-3 w-full" href="/es/encuentra-tus-unas/"
          >Encuentra tus uñas</a
        >
      </nav>
    </details>
  </div>
</header>
