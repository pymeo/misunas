---
import { getProductFactRows } from '@/application/product-facts';
import type { Product } from '@/domain/product';
interface Props {
  product: Product;
  compact?: boolean;
}
const { product, compact = false } = Astro.props;
const rows = getProductFactRows(product);
---

<dl class:list={['grid gap-3', compact ? 'text-sm' : 'sm:grid-cols-2']}>
  {
    rows.map((row) => (
      <div class="rounded-xl bg-background p-4">
        <dt class="text-xs font-bold tracking-wide text-muted uppercase">
          {row.label}
        </dt>
        <dd class="mt-1 font-semibold">{row.value}</dd>
      </div>
    ))
  }
</dl>
