---
import {
  getEditorialPick,
  getResolvedAlternative,
} from '@/data/editorialSelections';
import type { Product } from '@/domain/product';
interface Props {
  product: Product;
}
const { product } = Astro.props;
const pick = getEditorialPick(product.id);
const alternativeProduct = pick ? getResolvedAlternative(pick) : undefined;
---

{
  pick && (
    <div class="rounded-card border border-primary/25 bg-blush p-6 sm:p-7">
      <p class="text-sm font-bold text-primary">
        Veredicto Tus-Uñas · {pick.badge}
      </p>
      <p class="mt-3 leading-7 text-text">{pick.verdict}</p>
      <p class="mt-5 text-sm font-bold text-text">
        Ideal para:{' '}
        <span class="font-normal text-muted">{pick.bestFor.join(' · ')}</span>
      </p>
      <p class="mt-4 text-sm font-bold text-text">Lo que más nos gusta</p>
      <ul class="mt-2 grid gap-1.5 text-sm text-muted">
        {pick.reasons.map((reason) => (
          <li>✓ {reason}</li>
        ))}
      </ul>
      {pick.alternative && alternativeProduct && (
        <p class="mt-5 text-sm text-muted">
          {pick.alternative.label} →{' '}
          <a
            class="font-bold text-primary"
            href={`/es/productos/${alternativeProduct.slug}/`}
          >
            mira {alternativeProduct.brand}
          </a>
        </p>
      )}
    </div>
  )
}
