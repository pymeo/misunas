---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section
  class="rounded-card border border-border bg-lavender/40 p-6"
  data-product-statistics
  data-slug={slug}
>
  <p class="eyebrow">Duración de la comunidad</p><div data-statistics-content>
    <h3 class="mt-3 text-2xl">
      Aún estamos recopilando experiencias de este producto
    </h3><p class="mt-3 text-muted">
      ¿Lo has utilizado? Cuéntanos cuánto te duró y ayuda a mejorar los datos de
      Tus-Uñas.
    </p><a class="button-secondary mt-5" href="#registrar-duracion"
      >Registrar mi experiencia</a>
  </div>
</section>
<script>
  interface Stats {
    sufficientSample: boolean;
    sampleSize: number;
    averageWearDays: number | null;
    medianWearDays: number | null;
    distribution: Record<string, number> | null;
  }
  const bucketLabels: Record<string, string> = {
    from1To3: '1–3 días',
    from4To7: '4–7 días',
    from8To10: '8–10 días',
    from11To14: '11–14 días',
    atLeast15: '15+ días',
  };
  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-product-statistics]',
  )) {
    const content = root.querySelector<HTMLElement>(
      '[data-statistics-content]',
    );
    if (!content) continue;
    void fetch(`/api/products/${root.dataset.slug ?? ''}/statistics/`)
      .then((response) =>
        response.ok ? (response.json() as Promise<Stats>) : null,
      )
      .then((stats) => {
        if (!stats?.sufficientSample || !stats.distribution) return;
        content.replaceChildren();
        const summary = document.createElement('div');
        summary.className = 'mt-4 grid grid-cols-2 gap-3';
        [
          ['Mediana', stats.medianWearDays],
          ['Media', stats.averageWearDays],
        ].forEach(([label, value]) => {
          const item = document.createElement('div');
          item.className = 'rounded-xl bg-white p-4';
          const term = document.createElement('p');
          term.className = 'text-xs font-bold text-muted uppercase';
          term.textContent = String(label);
          const number = document.createElement('p');
          number.className = 'mt-1 text-2xl font-bold';
          number.textContent = `${String(value).replace('.', ',')} días`;
          item.appendChild(term);
          item.appendChild(number);
          summary.appendChild(item);
        });
        content.appendChild(summary);
        const max = Math.max(...Object.values(stats.distribution), 1);
        const chart = document.createElement('div');
        chart.className = 'mt-6 grid gap-3';
        for (const [bucket, count] of Object.entries(stats.distribution)) {
          const row = document.createElement('div');
          row.className =
            'grid grid-cols-[5rem_1fr_2rem] items-center gap-2 text-xs';
          const label = document.createElement('span');
          label.textContent = bucketLabels[bucket] ?? bucket;
          const track = document.createElement('span');
          track.className = 'h-2 overflow-hidden rounded-full bg-white';
          const bar = document.createElement('span');
          bar.className = 'block h-full rounded-full bg-primary';
          bar.style.width = `${(count / max) * 100}%`;
          track.appendChild(bar);
          const value = document.createElement('span');
          value.textContent = String(count);
          row.appendChild(label);
          row.appendChild(track);
          row.appendChild(value);
          chart.appendChild(row);
        }
        content.appendChild(chart);
        const sample = document.createElement('p');
        sample.className = 'mt-5 text-xs text-muted';
        sample.textContent = `Basado en ${stats.sampleSize} experiencias anónimas.`;
        content.appendChild(sample);
      })
      .catch(() => undefined);
  }
</script>
