---
interface Props {
  title: string;
  description: string;
  href?: string;
  icon: string;
  tone?: 'blush' | 'lavender' | 'cream';
  /** Sello corto opcional (p. ej. "Nuevo") para destacar una entrada puntual sin desplazar el resto de la cuadrícula. */
  badge?: string;
}
const { title, description, href, icon, tone = 'blush', badge } = Astro.props;
const classes = {
  blush: 'bg-blush',
  lavender: 'bg-lavender',
  cream: 'bg-cream',
};
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={[
    'group relative rounded-card border border-border p-5 no-underline',
    classes[tone],
  ]}
  href={href}
  aria-disabled={!href}
  >{
    badge && (
      <span class="absolute top-4 right-4 rounded-full bg-primary px-2.5 py-1 text-[.65rem] font-bold tracking-wide text-white uppercase">
        {badge}
      </span>
    )
  }<span class="text-2xl" aria-hidden="true">{icon}</span><h3
    class="mt-5 text-xl"
  >
    {title}
  </h3><p class="mt-2 text-sm leading-6 text-muted">{description}</p></Tag
>
