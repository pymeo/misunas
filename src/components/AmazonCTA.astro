---
import { buildAmazonAffiliateUrl } from '@/application/affiliate';
import type { Product } from '@/domain/product';

interface Props {
  product: Product;
  sourcePage: string;
  component?: string;
  position?: number;
  label?: string;
}
const {
  product,
  sourcePage,
  component = 'amazon-cta',
  position,
  label = 'Ver precio actualizado en Amazon',
} = Astro.props;
const href =
  product.active &&
  product.affiliateEligible &&
  product.editorialStatus === 'approved'
    ? buildAmazonAffiliateUrl(product)
    : null;
---

{
  href && (
    <a
      class="amazon-cta button-primary"
      href={href}
      rel="sponsored nofollow noopener"
      target="_blank"
      data-product-id={product.id}
      data-source-page={sourcePage}
      data-component={component}
      data-position={position}
      aria-label={`Ver precio de ${product.name} en Amazon (abre en una pestaña nueva)`}
    >
      {label}{' '}
      <span class="ml-2" aria-hidden="true">
        ↗
      </span>
    </a>
  )
}

<script>
  import { readCampaignAttribution } from '@/application/campaignAttribution';

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '.amazon-cta',
  )) {
    link.addEventListener('click', () => {
      const payload = JSON.stringify({
        productId: link.dataset.productId,
        sourcePage: link.dataset.sourcePage,
        component: link.dataset.component,
        ...(link.dataset.position
          ? { position: Number(link.dataset.position) }
          : {}),
        campaign: readCampaignAttribution(window.location.search),
      });
      navigator.sendBeacon(
        '/api/events/amazon-click/',
        new Blob([payload], { type: 'application/json' }),
      );
    });
  }
</script>
