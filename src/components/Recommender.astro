---
import { SAMPLE_PRODUCTS } from '@/data/products.sample';
const products = import.meta.env.DEV ? SAMPLE_PRODUCTS : [];
---

<section class="card" data-recommender data-products={JSON.stringify(products)}>
  {
    products.length > 0 && (
      <p class="mb-6 rounded-lg bg-sand p-4 text-sm">
        <strong>Modo desarrollo:</strong> los resultados usan fixtures SAMPLE,
        no recomendaciones comerciales reales.
      </p>
    )
  }
  <form class="grid gap-7">
    <fieldset>
      <legend class="font-serif text-xl font-bold"
        >1. ¿Qué estilo prefieres?</legend
      >
      <div class="mt-3 flex flex-wrap gap-3">
        {
          ['natural', 'francesa', 'elegante', 'llamativa'].map((value) => (
            <label class="rounded-full border border-line bg-white px-4 py-2">
              <input
                class="mr-2 accent-plum"
                type="radio"
                name="style"
                value={value}
                required
              />
              {value}
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-serif text-xl font-bold">2. ¿Qué priorizas?</legend>
      <div class="mt-3 flex flex-wrap gap-3">
        {
          [
            ['duracion', 'Duración'],
            ['facilidad', 'Facilidad'],
            ['precio', 'Precio'],
            ['diseno', 'Diseño'],
          ].map(([value, label]) => (
            <label class="rounded-full border border-line bg-white px-4 py-2">
              <input
                class="mr-2 accent-plum"
                type="radio"
                name="priority"
                value={value}
                required
              />
              {label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-serif text-xl font-bold"
        >3. ¿Tienes lámpara UV?</legend
      >
      <div class="mt-3 flex flex-wrap gap-3">
        {
          [
            ['si', 'Sí'],
            ['no', 'No'],
            ['comprar', 'Quiero comprarla'],
          ].map(([value, label]) => (
            <label class="rounded-full border border-line bg-white px-4 py-2">
              <input
                class="mr-2 accent-plum"
                type="radio"
                name="lamp"
                value={value}
                required
              />
              {label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-serif text-xl font-bold"
        >4. ¿Cómo son tus uñas?</legend
      >
      <div class="mt-3 flex flex-wrap gap-3">
        {
          ['normal', 'flexible', 'quebradiza'].map((value) => (
            <label class="rounded-full border border-line bg-white px-4 py-2">
              <input
                class="mr-2 accent-plum"
                type="radio"
                name="nailType"
                value={value}
                required
              />
              {value}
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="font-serif text-xl font-bold"
        >5. ¿Cuánta exposición al agua tienes?</legend
      >
      <div class="mt-3 flex flex-wrap gap-3">
        {
          ['baja', 'media', 'alta'].map((value) => (
            <label class="rounded-full border border-line bg-white px-4 py-2">
              <input
                class="mr-2 accent-plum"
                type="radio"
                name="waterExposure"
                value={value}
                required
              />
              {value}
            </label>
          ))
        }
      </div>
    </fieldset>
    <button class="button-primary justify-self-start" type="submit"
      >Ver compatibilidad orientativa</button
    >
  </form>
  <div class="mt-10 hidden" data-recommendation-results aria-live="polite">
    <h2 class="text-3xl">Compatibilidad orientativa</h2>
    <div class="mt-5 grid gap-5 md:grid-cols-3" data-result-list></div>
  </div>
</section>

<script>
  import {
    recommendProducts,
    type RecommendationAnswers,
  } from '@/application/recommendation';
  import type { Product } from '@/domain/product';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-recommender]',
  )) {
    const form = root.querySelector('form');
    const results = root.querySelector<HTMLElement>(
      '[data-recommendation-results]',
    );
    const list = root.querySelector<HTMLElement>('[data-result-list]');
    if (!(form instanceof HTMLFormElement) || !results || !list) continue;
    const products = JSON.parse(root.dataset.products ?? '[]') as Product[];
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const answers = Object.fromEntries(
        data.entries(),
      ) as unknown as RecommendationAnswers;
      const recommendations = recommendProducts(products, answers);
      list.replaceChildren();
      if (recommendations.length === 0) {
        const message = document.createElement('p');
        message.className = 'text-muted md:col-span-3';
        message.textContent =
          'El catálogo editorial todavía está en preparación. Vuelve pronto para obtener recomendaciones verificadas.';
        list.appendChild(message);
      }
      for (const recommendation of recommendations) {
        const article = document.createElement('article');
        article.className = 'rounded-card border border-line bg-white p-5';
        const heading = document.createElement('h3');
        heading.className = 'text-xl';
        heading.textContent = recommendation.product.name;
        const brand = document.createElement('p');
        brand.className = 'mt-1 text-sm text-muted';
        brand.textContent = recommendation.product.brand;
        const reasons = document.createElement('ul');
        reasons.className = 'mt-4 list-disc space-y-2 pl-5 text-sm';
        for (const reason of recommendation.reasons) {
          const item = document.createElement('li');
          item.textContent = reason;
          reasons.appendChild(item);
        }
        article.appendChild(heading);
        article.appendChild(brand);
        article.appendChild(reasons);
        list.appendChild(article);
      }
      results.classList.remove('hidden');
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (recommendations.length > 0) {
        void fetch('/api/recommendations/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            resultProductIds: recommendations.map(({ product }) => product.id),
            answers,
          }),
          keepalive: true,
        });
      }
    });
  }
</script>
