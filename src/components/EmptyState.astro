---
interface Props { title: string; description: string; href?: string; cta?: string }
const { title, description, href, cta } = Astro.props;
---
<div class="rounded-card border border-dashed border-border bg-surface p-7 text-center"><div class="mx-auto grid size-11 place-items-center rounded-full bg-lavender text-xl" aria-hidden="true">◇</div><h3 class="mt-4 text-2xl">{title}</h3><p class="mx-auto mt-3 max-w-xl text-muted">{description}</p>{href && cta && <a class="button-secondary mt-5" href={href}>{cta}</a>}</div>
