---
import AmazonCTA from '@/components/AmazonCTA.astro';
import ProductVisual from '@/components/ProductVisual.astro';
import type { Product } from '@/domain/product';
interface Props {
  product: Product;
  sourcePage: string;
  position?: number;
  commercial?: boolean;
}
const { product, sourcePage, position, commercial = false } = Astro.props;
---

<article
  class="card flex h-full flex-col p-4 sm:p-5"
  data-product-card
  data-requires-lamp={String(product.requiresLamp ?? false)}
  data-style-tags={product.styleTags.join(' ')}
>
  <ProductVisual {product} compact />
  <div class="flex flex-1 flex-col px-1 pt-5">
    <p class="text-xs font-bold tracking-[.14em] text-primary uppercase">
      {product.brand}
    </p><h3 class="mt-2 text-xl leading-snug">
      <a class="no-underline" href={`/es/productos/${product.slug}/`}
        >{product.name}</a
      >
    </h3><p class="mt-3 text-sm leading-6 text-muted">{product.summary}</p><div
      class="mt-4 flex flex-wrap gap-2"
    >
      {
        product.styleTags
          .slice(0, 3)
          .map((tag) => <span class="tag">{tag}</span>)
      }
    </div><div class="mt-auto flex flex-wrap items-center gap-2 pt-6">
      <a class="button-quiet px-2" href={`/es/productos/${product.slug}/`}
        >Ver análisis</a
      >{
        commercial && (
          <AmazonCTA
            {product}
            {sourcePage}
            component="product-card"
            {...(position === undefined ? {} : { position })}
          />
        )
      }
    </div>
  </div>
</article>
