---
import { SITE_NAME } from '@/config/site';
const year = new Date().getUTCFullYear();
---

<footer class="mt-24 border-t border-border bg-surface py-14">
  <div
    class="container-page grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]"
  >
    <div>
      <p class="font-editorial text-2xl font-bold text-primary">
        {SITE_NAME}
      </p><p class="mt-3 max-w-sm text-sm leading-6 text-muted">
        Descubre, compara y elige productos para tus uñas con datos claros y
        experiencias reales.
      </p>
    </div>
    <nav aria-label="Descubre">
      <p class="footer-title">Descubre</p><ul class="footer-links">
        <li><a href="/es/unas-semicuradas/">Semicuradas</a></li><li>
          <a href="/es/tornos-unas/">Tornos</a>
        </li><li>
          <a href="/es/aspiradores-polvo-unas/">Aspiradores</a>
        </li><li><a href="/es/comparativas/">Comparativas</a></li><li>
          <a href="/es/guias/">Guías</a>
        </li><li>
          <a href="/es/herramientas/">Herramientas</a>
        </li>
      </ul>
    </nav>
    <nav aria-label="Información">
      <p class="footer-title">Información</p><ul class="footer-links">
        <li><a href="/es/sobre-nosotras/">Sobre nosotras</a></li><li>
          <a href="/es/metodologia/">Metodología</a>
        </li><li><a href="/es/aviso-afiliados/">Afiliados</a></li><li>
          <a href="/es/privacidad/">Privacidad</a>
        </li><li><a href="/es/cookies/">Cookies</a></li><li>
          <a href="/es/aviso-legal/">Aviso legal</a>
        </li>
      </ul>
    </nav>
  </div>
  <div
    class="container-page mt-10 border-t border-border pt-6 text-xs text-muted"
  >
    <p>
      © {year}
      {SITE_NAME}. La información de producto se revisa editorialmente; consulta
      siempre las instrucciones del fabricante.
    </p>
  </div>
</footer>
