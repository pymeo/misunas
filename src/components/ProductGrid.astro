---
import ProductCard from '@/components/ProductCard.astro';
import type { Product } from '@/domain/product';
interface Props {
  products: Product[];
  sourcePage: string;
  commercial?: boolean;
}
const { products, sourcePage, commercial = false } = Astro.props;
---

{
  products.length === 0 ? (
    <div class="rounded-card border border-border bg-surface p-7">
      <>
        <h3 class="text-2xl">Prueba con otros criterios</h3>
        <p class="mt-3 text-muted">
          Prueba otra categoría o vuelve al catálogo completo.
        </p>
      </>
    </div>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product, index) => (
        <ProductCard {product} {sourcePage} position={index + 1} {commercial} />
      ))}
    </div>
  )
}
