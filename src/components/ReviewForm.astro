---
interface Props {
  productId: string;
}
const { productId } = Astro.props;
---

<form
  class="grid gap-5 rounded-card border border-border bg-surface p-5 sm:p-7"
  data-review-form
  data-product-id={productId}
>
  <fieldset>
    <legend class="font-bold">Tu valoración</legend><div
      class="mt-2 flex flex-wrap gap-2"
    >
      {
        [1, 2, 3, 4, 5].map((rating) => (
          <label class="choice min-h-12 px-3">
            <>
              <input type="radio" name="rating" value={rating} required />
              <span aria-label={`${rating} de 5`}>{rating} ★</span>
            </>
          </label>
        ))
      }
    </div>
  </fieldset>
  <label class="grid gap-2 font-bold"
    >Título <span class="text-xs font-normal text-muted">Opcional</span><input
      class="input-field font-normal"
      name="title"
      maxlength="100"
    /></label
  >
  <label class="grid gap-2 font-bold"
    >Tu opinión<textarea
      class="input-field min-h-32 resize-y font-normal"
      name="body"
      minlength="40"
      maxlength="1500"
      required></textarea><span class="text-xs font-normal text-muted"
      >Entre 40 y 1.500 caracteres. No incluyas enlaces ni datos personales.</span
    ></label
  >
  <fieldset>
    <legend class="font-bold">¿Lo recomendarías?</legend><div
      class="mt-2 grid grid-cols-2 gap-2"
    >
      <label class="choice"
        ><input type="radio" name="recommend" value="true" required />Sí</label
      ><label class="choice"
        ><input type="radio" name="recommend" value="false" required />No</label
      >
    </div>
  </fieldset>
  <label class="sr-only" aria-hidden="true"
    >Sitio web<input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
    /></label
  >
  <button class="button-primary" type="submit">Compartir mi opinión</button><p
    class="text-sm font-semibold"
    data-status
    aria-live="polite"
  >
  </p>
</form>
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-review-form]',
  ))
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const status = form.querySelector<HTMLElement>('[data-status]');
      try {
        const response = await fetch('/api/reviews/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            productId: form.dataset.productId,
            rating: Number(data.get('rating')),
            title: data.get('title'),
            body: data.get('body'),
            recommend: data.get('recommend') === 'true',
            website: data.get('website'),
          }),
        });
        if (status)
          status.textContent = response.ok
            ? '¡Gracias! Tu opinión se revisará antes de publicarse.'
            : 'No se ha podido enviar. Revisa el texto o inténtalo más tarde.';
        if (response.ok) form.reset();
      } catch {
        if (status)
          status.textContent = 'No se ha podido conectar. Inténtalo más tarde.';
      }
    });
</script>
