---
import { getRelatedContent } from '@/config/contentRelations';
interface Props {
  path: string;
  eyebrow?: string;
  heading?: string;
}
const {
  path,
  eyebrow = 'Relacionado',
  heading = 'Sigue por aquí',
} = Astro.props;
const links = getRelatedContent(path);
---

{
  links.length > 0 && (
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-heading">{heading}</h2>
      <div class="mt-7 grid gap-4">
        {links.map((link) => (
          <a class="card no-underline" href={link.href}>
            <h3 class="text-2xl">{link.title}</h3>
            <p class="mt-2 text-muted">{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  )
}
