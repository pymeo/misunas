---
interface Topic {
  title: string;
  body: string;
}
interface Props {
  heading: string;
  intro?: string;
  topics: Topic[];
}
const { heading, intro, topics } = Astro.props;
---

<div class="min-w-0">
  <p class="eyebrow">Cómo elegir</p>
  <h2 class="section-heading">{heading}</h2>
  {intro && <p class="section-intro">{intro}</p>}
  <ol class="mt-7 grid gap-5">
    {
      topics.map((topic, index) => (
        <li class="card">
          <strong>
            {index + 1}. {topic.title}
          </strong>
          <p class="mt-2 text-muted">{topic.body}</p>
        </li>
      ))
    }
  </ol>
</div>
