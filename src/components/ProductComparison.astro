---
import AmazonCTA from '@/components/AmazonCTA.astro';
import ProductVisual from '@/components/ProductVisual.astro';
import { getProductFactRows } from '@/application/product-facts';
import type { Product } from '@/domain/product';
interface Props {
  products: Product[];
  sourcePage?: string;
  interactive?: boolean;
}
const {
  products,
  sourcePage = '/es/comparar/',
  interactive = false,
} = Astro.props;
const visible = products.slice(0, interactive ? products.length : 4);
---

<section data-comparison data-interactive={String(interactive)}>
  {
    visible.length === 0 && (
      <div class="rounded-card border border-border bg-surface p-7">
        <>
          <h3 class="text-2xl">Prueba con otra selección</h3>
          <p class="mt-3 text-muted">
            Elige otros criterios para encontrar productos que puedas comparar.
          </p>
        </>
      </div>
    )
  }
  {
    interactive && (
      <fieldset class="mb-7 rounded-card border border-border bg-surface p-5">
        <>
          <legend class="px-2 font-editorial text-xl font-bold">
            Elige entre 2 y 4 productos
          </legend>
          <p class="mb-4 text-sm text-muted" data-comparison-status>
            Hay 4 productos seleccionados.
          </p>
          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {visible.map((product, index) => (
              <label class="choice text-sm">
                <input
                  type="checkbox"
                  value={product.id}
                  checked={index < 4}
                  data-comparison-choice
                />
                {product.brand} · {product.name}
              </label>
            ))}
          </div>
        </>
      </fieldset>
    )
  }
  <div
    class="-mx-5 overflow-x-auto px-5 pb-5 sm:mx-0 sm:px-0"
    tabindex="0"
    aria-label="Comparativa de productos, desplázate horizontalmente en móvil"
  >
    <div
      class="flex min-w-max snap-x snap-mandatory gap-4"
      data-comparison-list
    >
      {
        visible.map((product, index) => (
          <article
            class="w-[78vw] max-w-[19rem] shrink-0 snap-start overflow-hidden rounded-card border border-border bg-surface shadow-card"
            data-comparison-product={product.id}
            hidden={interactive && index >= 4}
          >
            <div class="sticky top-18 z-10 bg-surface p-4 pb-3">
              <>
                <ProductVisual {product} compact />
                <p class="mt-4 text-xs font-bold tracking-wider text-primary uppercase">
                  {product.brand}
                </p>
                <h3 class="mt-1 min-h-14 text-xl leading-snug">
                  <a
                    class="no-underline"
                    href={`/es/productos/${product.slug}/`}
                  >
                    {product.name}
                  </a>
                </h3>
              </>
            </div>
            <dl class="divide-y divide-border border-y border-border text-sm">
              {getProductFactRows(product).map((row) => (
                <div class="p-4">
                  <dt class="text-xs font-bold text-muted uppercase">
                    {row.label}
                  </dt>
                  <dd class="mt-1 font-semibold">{row.value}</dd>
                </div>
              ))}
              {product.styleTags.length > 0 && (
                <div class="p-4">
                  <dt class="text-xs font-bold text-muted uppercase">Estilo</dt>
                  <dd class="mt-2 flex flex-wrap gap-1">
                    {product.styleTags.slice(0, 3).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </dd>
                </div>
              )}
              {product.useCases.length > 0 && (
                <div class="p-4">
                  <dt class="text-xs font-bold text-muted uppercase">
                    Uso identificado
                  </dt>
                  <dd class="mt-1">{product.useCases.join(' · ')}</dd>
                </div>
              )}
            </dl>
            <div class="p-4">
              <AmazonCTA
                {product}
                {sourcePage}
                component="comparison"
                position={index + 1}
              />
            </div>
          </article>
        ))
      }
    </div>
  </div><p class="mt-2 text-sm text-muted">
    Desliza lateralmente en móvil para ver cada producto y sus características.
  </p>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-comparison][data-interactive="true"]',
  )) {
    const choices = [
      ...root.querySelectorAll<HTMLInputElement>('[data-comparison-choice]'),
    ];
    const status = root.querySelector<HTMLElement>('[data-comparison-status]');
    const update = (changed?: HTMLInputElement) => {
      const checked = choices.filter((choice) => choice.checked);
      if (checked.length > 4 && changed) changed.checked = false;
      const selected = new Set(
        choices
          .filter((choice) => choice.checked)
          .map((choice) => choice.value),
      );
      for (const card of root.querySelectorAll<HTMLElement>(
        '[data-comparison-product]',
      ))
        card.hidden = !selected.has(card.dataset.comparisonProduct ?? '');
      if (status)
        status.textContent =
          selected.size < 2
            ? 'Selecciona al menos 2 productos.'
            : `Hay ${selected.size} productos seleccionados.`;
    };
    for (const choice of choices)
      choice.addEventListener('change', () => update(choice));
    update();
  }
</script>
