---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  href: string;
}
const { eyebrow = 'Guía', title, description, href } = Astro.props;
---

<article class="rounded-card border border-border bg-surface p-6">
  <p class="eyebrow">{eyebrow}</p><h3 class="mt-3 text-2xl">
    <a class="no-underline" href={href}>{title}</a>
  </h3><p class="mt-3 leading-7 text-muted">{description}</p><a
    class="mt-5 inline-block font-bold text-primary"
    href={href}>Leer guía →</a>
</article>
