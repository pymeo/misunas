---
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Página no encontrada"
  description="No hemos encontrado la página que buscas en Tus-Uñas."
  canonicalPath="/404/"
  noindex
>
  <section class="container-page py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-4 text-5xl">Parece que esta uña se nos ha despegado 💅</h1>
    <p class="mt-5 text-lg text-muted">
      Puede que el enlace haya cambiado o que la dirección no sea correcta.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="button-primary" href="/es/">Volver al inicio</a><a
        class="button-secondary"
        href="/es/encuentra-tus-unas/">Encontrar mis uñas</a
      >
    </div>
    <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
      <a href="/es/unas-semicuradas/">Semicuradas</a><a href="/es/tornos-unas/"
        >Tornos</a
      ><a href="/es/aspiradores-polvo-unas/">Aspiradores</a><a
        href="/es/impresoras-unas-3d/">Impresoras 3D</a
      >
    </div>
  </section>
</BaseLayout>
