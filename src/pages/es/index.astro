---
import ArticleCard from '@/components/ArticleCard.astro';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import ProductComparison from '@/components/ProductComparison.astro';
import { organizationJsonLd, websiteJsonLd } from '@/application/jsonld';
import { FEATURED_PRODUCTS } from '@/data/products';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Uñas y manicura en casa: compara y elige mejor"
  description="Comparativas, guías, herramientas y experiencias reales para elegir productos de uñas y manicura en casa con datos claros."
  canonicalPath="/es/"
  jsonLd={[websiteJsonLd(), organizationJsonLd()]}
>
  <section
    class="container-page grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.08fr_.92fr] lg:py-24"
  >
    <div>
      <p class="eyebrow">Tu guía para la manicura en casa</p><h1
        class="mt-5 max-w-4xl text-5xl leading-[.98] sm:text-7xl"
      >
        Encuentra las uñas que mejor encajan contigo
      </h1><p class="mt-7 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
        Comparativas, guías y experiencias reales para elegir productos de
        manicura en casa sin perderte entre cientos de opciones.
      </p><div class="mt-9 flex flex-col gap-3 min-[430px]:flex-row">
        <a class="button-primary" href="/es/encuentra-tus-unas/"
          >Encuentra tus uñas</a
        ><a class="button-secondary" href="/es/comparar/">Ver comparativa</a>
      </div><p class="mt-6 text-xs font-semibold text-muted">
        Compara fácilmente · Encuentra tu estilo · Elige con confianza
      </p>
    </div>
    <div
      class="relative mx-auto aspect-[4/5] w-full max-w-lg overflow-hidden rounded-[2.5rem] bg-lavender"
      aria-label="Ilustración editorial abstracta de una manicura"
    >
      <div class="absolute -top-14 -right-14 size-56 rounded-full bg-cream">
      </div><div
        class="absolute -bottom-16 -left-16 size-64 rounded-full bg-blush"
      >
      </div><div
        class="absolute inset-x-[12%] top-[13%] flex justify-center gap-[7%]"
        aria-hidden="true"
      >
        <span
          class="h-56 w-[18%] -rotate-12 rounded-[999px] bg-white shadow-card"
        ></span><span
          class="h-64 w-[19%] -rotate-2 rounded-[999px] bg-accent/80 shadow-card"
        ></span><span
          class="h-60 w-[18%] rotate-8 rounded-[999px] bg-primary shadow-card"
        ></span>
      </div><div
        class="absolute right-6 bottom-7 left-6 rounded-2xl bg-white/85 p-5 backdrop-blur"
      >
        <p class="font-editorial text-xl font-bold text-primary">
          Elegir también puede ser sencillo.
        </p><p class="mt-1 text-sm text-muted">
          Primero el formato. Después el diseño.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Explora el catálogo actual</p><h2
      class="section-heading"
    >
      Empieza por el estilo o la lámpara
    </h2><div class="mt-8 grid gap-4 sm:grid-cols-3">
      <CategoryCard
        title="Uñas semicuradas"
        description="Catálogo, aplicación, retirada y criterios para comparar."
        href="/es/unas-semicuradas/"
        icon="◒"
      /><CategoryCard
        title="Francesas"
        description="Diseños franceses identificados en el catálogo verificado."
        href="/es/unas-semicuradas-francesas/"
        icon="◇"
        tone="blush"
      /><CategoryCard
        title="Con lámpara"
        description="Formatos UV/LED y kits donde la lámpara figura incluida."
        href="/es/unas-semicuradas-con-lampara/"
        icon="✦"
        tone="lavender"
      />
    </div>
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Empieza por aquí</p><h2 class="section-heading">
      Tres caminos, una decisión más clara
    </h2><div class="mt-8 grid gap-5 lg:grid-cols-3">
      <a
        class="rounded-[1.5rem] bg-primary p-7 text-white no-underline"
        href="/es/encuentra-tus-unas/"
        ><span class="text-sm font-bold text-blush">01 · RECOMENDADOR</span><h3
          class="mt-8 text-3xl"
        >
          Encuentra tus uñas
        </h3><p class="mt-3 text-white/75">
          Cuatro preguntas y razones concretas basadas en el catálogo.
        </p><span class="mt-7 inline-block font-bold">Empezar →</span></a
      ><a
        class="rounded-[1.5rem] bg-lavender p-7 text-text no-underline"
        href="/es/comparar/"
        ><span class="text-sm font-bold text-secondary">02 · COMPARADOR</span
        ><h3 class="mt-8 text-3xl">Comparar productos</h3><p
          class="mt-3 text-muted"
        >
          Pon 2–4 opciones frente a frente y descubre sus diferencias.
        </p><span class="mt-7 inline-block font-bold text-primary"
          >Comparar →</span
        ></a
      ><a
        class="rounded-[1.5rem] bg-cream p-7 text-text no-underline"
        href="/es/calculadora-ahorro-manicura/"
        ><span class="text-sm font-bold text-warning">03 · CALCULADORA</span><h3
          class="mt-8 text-3xl"
        >
          ¿Cuánto ahorrarías?
        </h3><p class="mt-3 text-muted">
          Usa tus propias cifras para comparar salón y manicura en casa.
        </p><span class="mt-7 inline-block font-bold text-primary"
          >Calcular →</span
        ></a
      >
    </div>
  </section>

  <section class="container-page py-14">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Comparativa destacada</p><h2 class="section-heading">
          Cuatro formatos para empezar
        </h2>
      </div><a class="font-bold text-primary" href="/es/comparar/"
        >Abrir comparador completo →</a
      >
    </div><div class="mt-8">
      <ProductComparison products={FEATURED_PRODUCTS} sourcePage="/es/" />
      <div class="mt-6"><AffiliateDisclosure /></div>
    </div>
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Nuestra selección</p><h2 class="section-heading">
      Lo que elegiríamos ahora
    </h2><p class="section-intro">
      Hemos revisado cada categoría y dejado claro qué elegiríamos y para qué
      tipo de persona, no solo una lista de enlaces.
    </p><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <CategoryCard
        title="Uñas semicuradas"
        description="Ver nuestras favoritas: kit para empezar, más tiras o francesa."
        href="/es/mejores-unas-semicuradas/#nuestra-seleccion"
        icon="◒"
      /><CategoryCard
        title="Tornos"
        description="Ver los tornos que elegiríamos según uso, pedal o portabilidad."
        href="/es/tornos-unas/#nuestra-seleccion"
        icon="◐"
        tone="blush"
      /><CategoryCard
        title="Aspiradores"
        description="Ver los aspiradores que elegiríamos según potencia o luz integrada."
        href="/es/aspiradores-polvo-unas/#nuestra-seleccion"
        icon="◍"
        tone="lavender"
      /><CategoryCard
        title="Impresoras de uñas 3D"
        description="Nail art digital en segundos: descubre qué impresora elegiríamos."
        href="/es/impresoras-unas-3d/#nuestra-seleccion"
        icon="🖨"
        tone="cream"
      />
    </div>
  </section>

  <section class="my-14 bg-primary py-16 text-white">
    <div class="container-page">
      <p class="text-xs font-bold tracking-[.18em] text-blush uppercase">
        Por qué Tus-Uñas
      </p><h2 class="mt-3 max-w-3xl text-4xl sm:text-5xl">
        La claridad es parte del producto
      </h2><div class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            [
              'Comparativas claras',
              'Atributos equivalentes, pensados para móvil.',
            ],
            [
              'Experiencias de la comunidad',
              'Aportaciones que ayudan a elegir con más contexto.',
            ],
            [
              'Decisiones más sencillas',
              'Formato, lámpara y estilo explicados con claridad.',
            ],
            [
              'Recomendaciones explicadas',
              'Cada resultado indica qué dato lo ha provocado.',
            ],
          ].map(([title, description], index) => (
            <div class="border-t border-white/25 pt-5">
              <>
                <span class="text-sm text-blush">0{index + 1}</span>
                <h3 class="mt-5 text-xl">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/70">
                  {description}
                </p>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Últimas guías</p><h2 class="section-heading">
      Aprende antes de elegir
    </h2><div class="mt-8 grid gap-5 lg:grid-cols-3">
      <ArticleCard
        title="Qué son las uñas semicuradas"
        description="Qué distingue este formato y qué conviene comprobar antes de usarlo."
        href="/es/que-son-las-unas-semicuradas/"
      /><ArticleCard
        title="Cómo poner uñas semicuradas"
        description="Una secuencia prudente de preparación, ajuste y curado."
        href="/es/como-poner-unas-semicuradas/"
      /><ArticleCard
        title="Cómo quitar uñas semicuradas"
        description="Principios para una retirada paciente siguiendo las instrucciones."
        href="/es/como-quitar-unas-semicuradas/"
      />
    </div>
  </section>
  <section class="container-page py-14">
    <p class="eyebrow">Experiencias de la comunidad</p><h2
      class="section-heading"
    >
      Tu experiencia puede ayudar a elegir
    </h2><div class="mt-8">
      <EmptyState
        title="¿Has probado alguno de estos productos?"
        description="Comparte tu opinión o cuéntanos cuánto te duró. Cada aportación ayuda a construir una guía más útil para la comunidad."
        href="/es/opiniones/"
        cta="Compartir mi experiencia"
      />
    </div>
  </section>
</BaseLayout>
