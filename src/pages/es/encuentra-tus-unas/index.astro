---
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import Recommender from '@/components/Recommender.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Encuentra tus uñas ideales"
  description="Responde cuatro preguntas y descubre hasta tres productos que coinciden con tu estilo, tu opción de lámpara y preferencias verificables."
  canonicalPath="/es/encuentra-tus-unas/"
  contentType="tool"
  breadcrumbs={[
    { label: 'Inicio', href: '/es/' },
    { label: 'Herramientas', href: '/es/herramientas/' },
    { label: 'Encuentra tus uñas' },
  ]}
>
  <section class="container-page py-10 sm:py-16">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">Te ayudamos a elegir</p><h1
        class="mt-4 text-5xl leading-tight sm:text-7xl"
      >
        Encuentra tus uñas ideales
      </h1><p
        class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl"
      >
        Responde 4 preguntas y descubre las opciones que mejor encajan con lo
        que buscas.
      </p><a class="button-primary mt-8" href="#recomendador"
        >Empezar · 30 segundos</a
      >
    </div><div class="mx-auto mt-12 max-w-4xl scroll-mt-24" id="recomendador">
      <Recommender />
      <div class="mt-6"><AffiliateDisclosure /></div>
    </div><p class="mx-auto mt-8 max-w-4xl text-center text-sm text-muted">
      <a href="/es/metodologia/">Cómo hacemos las recomendaciones</a>
    </p>
  </section>
</BaseLayout>
