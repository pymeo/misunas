---
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import Recommender from '@/components/Recommender.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Encuentra tus uñas ideales"
  description="Responde cuatro preguntas y descubre hasta tres productos que coinciden con tu estilo, tu opción de lámpara y preferencias verificables."
  canonicalPath="/es/encuentra-tus-unas/"
  contentType="tool"
  breadcrumbs={[
    { label: 'Inicio', href: '/es/' },
    { label: 'Herramientas', href: '/es/herramientas/' },
    { label: 'Encuentra tus uñas' },
  ]}
>
  <section class="container-page py-10 sm:py-16">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow">Te ayudamos a elegir</p><h1
        class="mt-4 text-5xl leading-tight sm:text-7xl"
      >
        Encuentra las uñas que encajan contigo
      </h1><p
        class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl"
      >
        Cuatro preguntas, hasta tres opciones y una explicación clara de cada
        coincidencia. Sin email, registro ni IA.
      </p><a class="button-primary mt-8" href="#recomendador"
        >Empezar · 30 segundos</a
      ><p class="mt-4 text-xs text-muted">
        Solo usamos estilo, lámpara, tipo de kit y cantidad de tiras verificada.
      </p>
    </div><div class="mx-auto mt-12 max-w-4xl scroll-mt-24" id="recomendador">
      <Recommender />
      <div class="mt-6"><AffiliateDisclosure /></div>
    </div><div class="mx-auto mt-10 max-w-3xl rounded-card bg-cream p-6">
      <h2 class="text-2xl">Una coincidencia, no una promesa</h2><p
        class="mt-3 leading-7 text-muted"
      >
        El resultado no utiliza duración, precio, tipo de uña, exposición al
        agua, resistencia, adherencia ni facilidad de retirada. Esas
        características no están respaldadas por el catálogo actual.
      </p>
    </div>
  </section>
</BaseLayout>
