---
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout
  title="Opiniones reales sobre productos para uñas"
  description="Cómo recopila, modera y publica Tus-Uñas opiniones propias y experiencias anónimas sobre productos de manicura."
  canonicalPath="/es/opiniones/"
  noindex
  breadcrumbs={[{ label: 'Inicio', href: '/es/' }, { label: 'Opiniones' }]}
>
  <section class="container-page py-10 sm:py-16">
    <p class="eyebrow">Comunidad</p><h1
      class="mt-4 max-w-4xl text-5xl sm:text-6xl"
    >
      Tu experiencia puede ayudar a otras usuarias
    </h1><p class="section-intro">
      Comparte cómo te fue con un producto del catálogo. Revisamos cada
      aportación antes de publicarla para mantener una comunidad útil y cuidada.
    </p><div class="mt-10">
      <EmptyState
        title="¿Has probado uno de estos productos?"
        description="Entra en su ficha para compartir tu opinión o registrar cuánto te duró. No necesitas crear una cuenta."
        href="/es/unas-semicuradas/"
        cta="Ver productos"
      />
    </div><div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        [
          ['1 · Comparte', 'Una opinión breve, sin crear una cuenta.'],
          ['2 · Revisamos', 'Comprobamos cada aportación antes de publicarla.'],
          [
            '3 · Publicamos',
            'Las opiniones aprobadas aparecen en la ficha del producto.',
          ],
        ].map(([title, body]) => (
          <div class="rounded-card bg-lavender p-6">
            <>
              <h2 class="text-2xl">{title}</h2>
              <p class="mt-3 text-muted">{body}</p>
            </>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
