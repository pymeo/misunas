---
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import CategoryExpertGuide from '@/components/CategoryExpertGuide.astro';
import EditorialTopPicks from '@/components/EditorialTopPicks.astro';
import MethodologyNotice from '@/components/MethodologyNotice.astro';
import ProductComparison from '@/components/ProductComparison.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import QuickChoiceGuide from '@/components/QuickChoiceGuide.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import SelectionMethodBand from '@/components/SelectionMethodBand.astro';
import { PRODUCTS } from '@/data/products';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
const tornos = PRODUCTS.filter((product) => product.category === 'tornos');
const featured = tornos.filter((product) =>
  [
    'kredioo-torno-profesional-35000-rpm',
    'nailgirls-torno-35000-rpm-pedal',
    'xoali-torno-25000-rpm-12-en-1',
    'bickon-torno-20000-rpm-6-en-1',
  ].includes(product.id),
);
const topics = [
  {
    title: 'Velocidad máxima (RPM)',
    body: 'Más RPM da más margen de regulación, no significa que debas usarlo siempre al máximo: para uñas naturales o cutícula suele bastar con una velocidad baja, y el resto del rango queda para gel o acrílico grueso.',
  },
  {
    title: 'Giro bidireccional',
    body: 'Poder invertir el sentido de giro es útil según con qué mano trabajes y en qué dirección limas cada uña; con un torno unidireccional tendrás que girar tú la mano para compensar.',
  },
  {
    title: 'Pedal',
    body: 'Un pedal te permite cambiar el control del equipo sin soltar la fresa ni recurrir siempre al botón manual, algo habitual en configuraciones tipo salón.',
  },
  {
    title: 'Batería o cable',
    body: 'Si vas a moverlo entre casa y salón, o simplemente no quieres depender de un enchufe cerca de la mesa, prioriza un modelo recargable o USB frente a uno con base fija.',
  },
  {
    title: 'Accesorios incluidos',
    body: 'Más cantidad de fresas no significa automáticamente mejores puntas: importa qué necesitas hacer (rebajar gel, pulir, retirar cutícula) más que el número total.',
  },
  {
    title: 'Si es tu primera vez',
    body: 'Al empezar importa más poder regular la velocidad y trabajar de forma progresiva que comprar directamente el torno con más RPM; un modelo sencillo con buen control a baja velocidad suele ser más cómodo para aprender.',
  },
];
---

<BaseLayout
  title="Tornos para uñas: comparativa y guía para elegir"
  description="Comparativa editorial de tornos eléctricos para uñas por RPM, alimentación, accesorios y pedal, con atributos verificados en Amazon.es y sin puntuaciones inventadas."
  canonicalPath="/es/tornos-unas/"
  breadcrumbs={[
    { label: 'Inicio', href: '/es/' },
    { label: 'Tornos para uñas' },
  ]}
>
  <section class="container-page py-10 sm:py-16">
    <p class="eyebrow">Equipamiento para manicura</p><h1
      class="mt-4 max-w-5xl text-5xl leading-tight sm:text-6xl"
    >
      Tornos para uñas: comparativa y guía para elegir
    </h1><p class="section-intro">
      Hemos revisado los ocho tornos eléctricos para uñas disponibles en
      Amazon.es y te explicamos cuáles elegiríamos según cómo vayas a usarlo.
    </p><div class="mt-8"><AffiliateDisclosure /></div>
  </section>

  <section class="container-page grid gap-6 pb-14">
    <EditorialTopPicks category="tornos" sourcePage="/es/tornos-unas/" />
    <SelectionMethodBand />
    <QuickChoiceGuide category="tornos" />
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Comparación esencial</p><h2 class="section-heading">
      Cuatro tornos, atributos equivalentes
    </h2><p class="section-intro">
      Compara velocidad, accesorios, pedal, alimentación y pantalla en cuatro
      formatos distintos.
    </p><div class="mt-8">
      <ProductComparison products={featured} sourcePage="/es/tornos-unas/" />
    </div>
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Selección completa</p><h2 class="section-heading">
      Los {tornos.length} tornos investigados
    </h2><div class="mt-8">
      <ProductGrid products={tornos} sourcePage="/es/tornos-unas/" commercial />
    </div>
  </section>

  <section class="container-page grid gap-10 py-14 lg:grid-cols-[1fr_.8fr]">
    <CategoryExpertGuide
      heading="Seis datos que importan de verdad"
      topics={topics}
    />
    <RelatedLinks path="/es/tornos-unas/" heading="Completa tu equipo" />
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Preguntas frecuentes</p><h2 class="section-heading">
      Lo que no cabe en una tarjeta
    </h2><div class="mt-7 grid gap-3">
      {
        [
          [
            '¿Necesito un torno si ya limo a mano?',
            'No es imprescindible. Un torno acelera el rebajado de gel o acrílico y el pulido, pero una lima manual sigue siendo válida para uñas naturales o retoques puntuales.',
          ],
          [
            '¿Es seguro usar un torno en casa?',
            'Sí, siguiendo las instrucciones del fabricante: velocidad baja al principio, ángulo suave y descansos. Si tienes dudas sobre tu técnica, un curso corto o un profesional pueden ayudarte a empezar.',
          ],
          [
            '¿Sirve el mismo torno para gel y acrílico?',
            'La mayoría de los modelos de esta comparativa indican uso para gel, acrílico, manicura y pedicura, pero conviene revisar los accesorios recomendados para cada material en la ficha del producto.',
          ],
          [
            '¿Dónde consulto el precio?',
            'El botón de cada producto abre su ficha de Amazon.es para consultar el precio y la disponibilidad actuales.',
          ],
        ].map(([question, answer]) => (
          <details class="rounded-xl border border-border bg-surface p-5">
            <summary class="cursor-pointer font-bold">{question}</summary>
            <p class="mt-3 text-muted">{answer}</p>
          </details>
        ))
      }
    </div><div class="mt-8"><MethodologyNotice /></div>
  </section>
</BaseLayout>
