---
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import CategoryExpertGuide from '@/components/CategoryExpertGuide.astro';
import EditorialTopPicks from '@/components/EditorialTopPicks.astro';
import MethodologyNotice from '@/components/MethodologyNotice.astro';
import ProductComparison from '@/components/ProductComparison.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import QuickChoiceGuide from '@/components/QuickChoiceGuide.astro';
import SelectionMethodBand from '@/components/SelectionMethodBand.astro';
import { FEATURED_PRODUCTS } from '@/data/products';
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
const topics = [
  {
    title: 'Con o sin lámpara',
    body: 'El gel semicurado UV/LED necesita curarse con lámpara; los formatos precured (como Mylee) se aplican sin ella. No son equivalentes: si no quieres usar lámpara, descarta directamente el semicurado UV y mira la alternativa precured.',
  },
  {
    title: 'Kit completo o solo tiras',
    body: 'Un kit de inicio reúne tiras y lámpara en el mismo paquete: cómodo si empiezas de cero. Si ya tienes lámpara, comprar solo tiras suele salir mejor que pagar por una segunda lámpara que no necesitas.',
  },
  {
    title: 'Número de tiras y tamaños',
    body: 'Más tiras por paquete no siempre significa más tamaños distintos: solo indicamos la cantidad cuando el fabricante la confirma, porque es lo que determina cuántos intentos tienes para encontrar el ajuste correcto en cada uña.',
  },
  {
    title: 'Estilo',
    body: 'Natural, francesa, floral o llamativo son etiquetas que verificamos contra el catálogo real, no una opinión sobre qué diseño es "mejor": el mejor estilo es el que realmente te vas a poner.',
  },
  {
    title: 'Tu primera aplicación',
    body: 'Si es tu primera vez, un kit con instrucciones y lámpara incluida reduce la curva de aprendizaje; con experiencia previa, puedes centrarte directamente en estilo y cantidad de tiras.',
  },
];
---

<BaseLayout
  title="Mejores uñas semicuradas: comparativa para elegir"
  description="Comparativa editorial de uñas semicuradas, kits con lámpara y una alternativa sin lámpara basada en atributos verificados y sin puntuaciones inventadas."
  canonicalPath="/es/mejores-unas-semicuradas/"
  breadcrumbs={[
    { label: 'Inicio', href: '/es/' },
    { label: 'Uñas semicuradas', href: '/es/unas-semicuradas/' },
    { label: 'Comparativa' },
  ]}
>
  <section class="container-page py-10 sm:py-16">
    <p class="eyebrow">Comparativa editorial</p><h1
      class="mt-4 max-w-5xl text-5xl leading-tight sm:text-6xl"
    >
      Mejores uñas semicuradas: comparativa y guía para elegir
    </h1><p class="section-intro">
      Hemos revisado el catálogo de uñas semicuradas investigado en Amazon.es y
      te explicamos cuáles elegiríamos según lo que busques.
    </p><div class="mt-8"><AffiliateDisclosure /></div>
  </section>

  <section class="container-page grid gap-6 pb-14">
    <EditorialTopPicks
      category="unas-semicuradas"
      sourcePage="/es/mejores-unas-semicuradas/"
    />
    <SelectionMethodBand />
    <QuickChoiceGuide category="unas-semicuradas" />
  </section>

  <section class="container-page py-14">
    <p class="eyebrow">Comparación esencial</p><h2 class="section-heading">
      Cuatro opciones, atributos equivalentes
    </h2><p class="section-intro">
      Compara una francesa, un diseño floral, un kit completo y un formato sin
      lámpara.
    </p><div class="mt-8">
      <ProductComparison
        products={FEATURED_PRODUCTS}
        sourcePage="/es/mejores-unas-semicuradas/"
      />
    </div>
  </section>
  <section class="container-page py-14">
    <p class="eyebrow">Fichas explicadas</p><h2 class="section-heading">
      Qué aporta cada opción
    </h2><div class="mt-8">
      <ProductGrid
        products={FEATURED_PRODUCTS}
        sourcePage="/es/mejores-unas-semicuradas/"
        commercial
      />
    </div>
  </section>
  <section class="container-page grid gap-10 py-14 lg:grid-cols-[1fr_.8fr]">
    <CategoryExpertGuide
      heading="Cinco datos que importan de verdad"
      topics={topics}
    /><div>
      <p class="eyebrow">Herramientas</p><h2 class="section-heading">
        Decide con ayuda
      </h2><div class="mt-7 grid gap-4">
        <a class="card no-underline" href="/es/encuentra-tus-unas/"
          ><h3 class="text-2xl">Encuentra tus uñas</h3><p
            class="mt-2 text-muted"
          >
            Cuatro preguntas, máximo tres resultados y razones visibles.
          </p></a
        ><a class="card no-underline" href="/es/calculadora-ahorro-manicura/"
          ><h3 class="text-2xl">Calcula tu ahorro</h3><p
            class="mt-2 text-muted"
          >
            Compara el salón con tus propios costes domésticos.
          </p></a
        >
      </div>
    </div>
  </section>
  <section class="container-page py-14">
    <p class="eyebrow">Preguntas frecuentes</p><h2 class="section-heading">
      Lo que no cabe en una tarjeta
    </h2><div class="mt-7 grid gap-3">
      {
        [
          [
            '¿Qué diferencia hay entre requerir e incluir lámpara?',
            'Un producto puede necesitar curado UV/LED sin traer lámpara. Los kits completos indican expresamente que la incluyen.',
          ],
          [
            '¿El kit es mejor para empezar?',
            'Un kit de inicio reúne las tiras y la lámpara en el mismo paquete, una opción cómoda si aún no tienes una.',
          ],
          [
            '¿Dónde consulto el precio?',
            'El botón de cada producto abre su ficha de Amazon.es para consultar el precio y la disponibilidad actuales.',
          ],
          [
            '¿Por qué importa el número de tiras?',
            'Una mayor variedad de tiras puede ofrecer más tamaños para encontrar el ajuste adecuado. Solo indicamos la cantidad confirmada de cada paquete.',
          ],
        ].map(([question, answer]) => (
          <details class="rounded-xl border border-border bg-surface p-5">
            <>
              <summary class="cursor-pointer font-bold">{question}</summary>
              <p class="mt-3 text-muted">{answer}</p>
            </>
          </details>
        ))
      }
    </div><div class="mt-8"><MethodologyNotice /></div>
  </section>
</BaseLayout>
